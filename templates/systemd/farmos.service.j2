[Unit]
Description=farmOS ({{ farmos_identifier }})
{% for service in farmos_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in farmos_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ farmos_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ farmos_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ farmos_identifier }} \
      --log-driver=none \
      --user={{ farmos_uid }}:{{ farmos_gid }} \
      --cap-drop=ALL \
      --network={{ farmos_container_network }} \
      {% if farmos_container_http_host_bind_port %}
      -p {{ farmos_container_http_host_bind_port }}:{{ farmos_container_http_port }} \
      {% endif %}
      --env-file={{ farmos_base_path }}/env \
      --label-file={{ farmos_base_path }}/labels \
      --mount type=bind,src={{ farmos_keys_path }},dst=/opt/drupal/keys \
      --mount type=bind,src={{ farmos_sites_path }},dst=/opt/drupal/web/sites \
      {% for volume in farmos_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      {% for arg in farmos_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ farmos_container_image_self_build_name if farmos_container_image_self_build else farmos_container_image }}

{% for network in farmos_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ farmos_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ farmos_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ farmos_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ farmos_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ farmos_identifier }}

[Install]
WantedBy=multi-user.target
