[Unit]
Description=SolidInvoice ({{ solidinvoice_identifier }})
{% for service in solidinvoice_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in solidinvoice_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ solidinvoice_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ solidinvoice_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ solidinvoice_identifier }} \
      --log-driver=none \
      --user={{ solidinvoice_uid }}:{{ solidinvoice_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ solidinvoice_container_network }} \
      {% if solidinvoice_container_http_host_bind_port %}
      -p {{ solidinvoice_container_http_host_bind_port }}:{{ solidinvoice_container_http_port }} \
      {% endif %}
      --env-file={{ solidinvoice_base_path }}/env \
      --label-file={{ solidinvoice_base_path }}/labels \
      --mount type=bind,src={{ solidinvoice_config_path }},dst=/.config \
      --mount type=bind,src={{ solidinvoice_data_path }},dst=/etc/solidinvoice \
      --mount type=bind,src={{ solidinvoice_local_path }},dst=/.local \
      --mount type=bind,src={{ solidinvoice_home_path }},dst=/.SolidInvoice \
      {% for volume in solidinvoice_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ solidinvoice_container_tmpfs_tmp_size }} \
      {% for arg in solidinvoice_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ solidinvoice_container_image }}

{% for network in solidinvoice_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ solidinvoice_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ solidinvoice_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ solidinvoice_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ solidinvoice_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ solidinvoice_identifier }}

[Install]
WantedBy=multi-user.target
