{% if farmos_container_labels_traefik_enabled %}
traefik.enable=true

{% if farmos_container_labels_traefik_docker_network %}
traefik.docker.network={{ farmos_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if farmos_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ farmos_identifier }}-slashless-redirect.redirectregex.regex=^({{ farmos_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ farmos_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [farmos_identifier + '-slashless-redirect'] %}
{% endif %}

{% if farmos_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ farmos_identifier }}-strip-prefix.stripprefix.prefixes={{ farmos_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [farmos_identifier + '-strip-prefix'] %}
{% endif %}

{% if farmos_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in farmos_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ farmos_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [farmos_identifier + '-add-request-headers'] %}
{% endif %}

{% if farmos_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in farmos_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ farmos_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [farmos_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ farmos_identifier }}.rule={{ farmos_container_labels_traefik_rule }}
{% if farmos_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ farmos_identifier }}.priority={{ farmos_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ farmos_identifier }}.service={{ farmos_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ farmos_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ farmos_identifier }}.entrypoints={{ farmos_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ farmos_identifier }}.tls={{ farmos_container_labels_traefik_tls | to_json }}
{% if farmos_container_labels_traefik_tls %}
traefik.http.routers.{{ farmos_identifier }}.tls.certResolver={{ farmos_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ farmos_identifier }}.loadbalancer.server.port={{ farmos_container_http_port }}
{% endif %}

{{ farmos_container_labels_additional_labels }}
